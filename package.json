{
  "name": "mindspool",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=12.8.1 <13"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @mindspool/web dev",
    "dev:mobile": "pnpm --filter @mindspool/mobile dev",
    "dev:extension": "pnpm --filter @mindspool/extension dev",
    "dev:backend": "pnpm --filter @mindspool/backend dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @mindspool/backend test && pnpm --filter @mindspool/web test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "prettier": "3.9.9"
  }
}
