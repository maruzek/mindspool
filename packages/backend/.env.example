# convex dev writes CONVEX_DEPLOYMENT and the deployment URL to .env.local.
# Configure this issuer on the Convex deployment using convex env set.
CLERK_JWT_ISSUER_DOMAIN=
# Optional, set with convex env set: daily Workers AI budget per owner in neurons
# (resets 00:00 UTC). Missing or invalid means 9000, 10% under the 10,000 free tier.
# AI_DAILY_NEURON_LIMIT=9000
