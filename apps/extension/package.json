{
  "name": "@mindspool/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run --passWithNoTests",
    "generate-key": "node scripts/generate-key.mjs",
    "sign:firefox": "node scripts/sign-firefox.mjs"
  },
  "dependencies": {
    "@clerk/chrome-extension": "3.1.90",
    "@fontsource-variable/archivo": "5.3.0",
    "@mindspool/backend": "workspace:*",
    "@mindspool/schema": "workspace:*",
    "@mindspool/ui": "workspace:*",
    "convex": "1.46.0",
    "lucide-react": "1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@mindspool/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.7",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "29.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
