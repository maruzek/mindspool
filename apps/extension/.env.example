WXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
WXT_PUBLIC_CLERK_FRONTEND_API=
# Public DER key, base64 encoded, to keep the Chrome extension ID stable.
CLERK_EXTENSION_PUBLIC_KEY=
WXT_PUBLIC_CONVEX_URL=
# Optional explicit HTTP-action origin; defaults to the .convex.site equivalent.
WXT_PUBLIC_CONVEX_HTTP_URL=
# Where the popup links to; defaults to http://localhost:5173.
WXT_PUBLIC_WEB_URL=
# Where the Clerk session cookie is read from. Dev: http://localhost (the web app's cookie). Prod: the Clerk Frontend API domain.
WXT_PUBLIC_CLERK_SYNC_HOST=
