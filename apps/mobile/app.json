{
  "expo": {
    "name": "MindSpool",
    "slug": "mindspool",
    "version": "0.0.1",
    "scheme": "mindspool",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mindspool.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ece7f4"
      }
    },
    "ios": {
      "bundleIdentifier": "com.mindspool.app"
    },
    "plugins": [
      "expo-secure-store",
      "@clerk/expo",
      "expo-font",
      "./plugins/withBackgroundShare"
    ],
    "owner": "maruzek",
    "extra": {
      "eas": {
        "projectId": "0aad285b-7e7f-4b07-9683-30798dbdc454"
      }
    },
    "icon": "./assets/icon.png"
  }
}
