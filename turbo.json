{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": [
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_CONVEX_URL",
        "WXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "WXT_PUBLIC_CLERK_FRONTEND_API",
        "CLERK_EXTENSION_PUBLIC_KEY",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_CONVEX_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "prepare": {
      "cache": false
    }
  }
}
